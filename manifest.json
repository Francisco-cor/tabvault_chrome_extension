{
  "manifest_version": 3,
  "name": "TabVault",
  "version": "1.0.0",
  "description": "Save, organize, and restore tab sessions with notes, tags, and fuzzy search",
  "minimum_chrome_version": "116",
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "windows",
    "sidePanel",
    "unlimitedStorage",
    "contextMenus",
    "alarms",
    "notifications",
    "favicon"
  ],
  "optional_permissions": ["history"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' data: chrome://favicon2"
  },
  "chrome_url_overrides": {
    "newtab": "newtab/newtab.html"
  },
  "background": {
    "service_worker": "background/sw-main.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "TabVault",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "save-session": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Save current session"
    },
    "stash-tab": {
      "suggested_key": {
        "default": "Ctrl+Shift+X",
        "mac": "Command+Shift+X"
      },
      "description": "Stash current tab in TabVault"
    },
    "quick-switcher": {
      "description": "Open TabVault Quick Switcher (bind in chrome://extensions/shortcuts)"
    },
    "quick-search": {
      "description": "Search saved tabs in TabVault (bind in chrome://extensions/shortcuts)"
    },
    "toggle-theme": {
      "description": "Toggle dark/light theme (bind in chrome://extensions/shortcuts)"
    },
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+V",
        "mac": "Command+Shift+V"
      }
    }
  }
}
