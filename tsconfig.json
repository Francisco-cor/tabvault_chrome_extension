{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["chrome"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "noImplicitOverride": true,
    "skipLibCheck": true
  },
  "include": [
    "core/**/*.js",
    "shared/**/*.js",
    "background/**/*.js",
    "ui/**/*.js",
    "popup/**/*.js",
    "tests/**/*.js"
  ],
  "exclude": ["tests/e2e"]
}
